# Local development. Copy to .env.local. lib/env.ts checks these at boot and the server
# exits naming any that are missing or malformed; a blank value counts as unset.
DATABASE_URL=postgres://homedocs:homedocs@localhost:54330/homedocs
# Required, at least 32 characters: `openssl rand -base64 48`. Rotating it signs everyone out.
SESSION_SECRET=
# Required, at least 32 characters, and NOT the same as SESSION_SECRET. Encrypts stored
# secrets (Wi-Fi, alarm codes) and integration tokens. Losing or changing it makes
# those unreadable — back it up with the database. `openssl rand -base64 48`
INTEGRATIONS_KEY=
# Required. The external https origin, no path; http only for localhost.
PUBLIC_BASE_URL=http://localhost:3000
# Where photos and files live. Defaults to ./data in development.
DATA_DIR=
# How many reverse proxies sit in front of the app (a whole number, default 1). The
# client address is read that many entries from the right of X-Forwarded-For, which
# a client cannot forge. Or CLIENT_IP_HEADER: one header name the proxy in front sets
# to the client address on every request (e.g. x-real-ip); it replaces the count.
TRUSTED_PROXY_HOPS=
CLIENT_IP_HEADER=
# Single sign-on (OpenID Connect). Off unless all three are set; two of three
# fails the boot. The issuer is an http(s) URL. Register <PUBLIC_BASE_URL>/login/oidc/callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=
# Flags take true, false, 1, 0, yes, no, on or off.
OIDC_ONLY=
OIDC_TRUST_EMAIL=
# Role for a sign-on that matches no account: viewer (default) or member.
OIDC_DEFAULT_ROLE=
# off keeps this process from running background jobs; on or unset runs them.
WORKER=
