{
  "name": "homedocs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx lib/db/migrate.ts",
    "db:drift": "sh scripts/db-drift.sh",
    "render:icons": "tsx scripts/render-icons.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@node-rs/argon2": "2.1.0",
    "drizzle-orm": "0.45.2",
    "next": "16.4.6",
    "openid-client": "6.8.8",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
